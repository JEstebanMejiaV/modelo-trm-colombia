{
  "title": "Long-horizon wavelet optimization research configuration",
  "type": "object",
  "required": [
    "schema_version",
    "variant_id",
    "experiment_id",
    "product_id",
    "status",
    "information_set",
    "vintage_policy",
    "target_series",
    "target_definition",
    "horizons_months",
    "evaluation_splits",
    "minimum_mature_training",
    "dm_min_observations",
    "dm_max_lag_rule",
    "primary_metric",
    "selection_rule",
    "tie_break_rule",
    "seed",
    "data_cutoff_required",
    "dwt",
    "benchmark",
    "label_maturity",
    "promotion_gate",
    "hypotheses",
    "candidates"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "variant_id": {"type": "string", "enum": ["long_horizon_wavelet_optimization"]},
    "experiment_id": {
      "type": "string",
      "enum": ["long_horizon_research.wavelet_optimization.v1"]
    },
    "product_id": {"type": "string", "enum": ["long_horizon_research"]},
    "status": {"type": "string", "enum": ["research"]},
    "information_set": {"type": "string", "enum": ["vintage_backtest"]},
    "vintage_policy": {"type": "string", "enum": ["vintage_backtest"]},
    "target_series": {"type": "string", "enum": ["banrep_trm_1"]},
    "target_definition": {
      "type": "string",
      "enum": ["100 * (ln(TRM[t+h]) - ln(TRM[t]))"]
    },
    "horizons_months": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1}
    },
    "evaluation_splits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "minimum_mature_training": {"type": "integer", "minimum": 1},
    "dm_min_observations": {"type": "integer", "minimum": 1},
    "dm_max_lag_rule": {"type": "string", "enum": ["horizon_minus_one"]},
    "primary_metric": {"type": "string", "enum": ["r2_oos"]},
    "selection_rule": {
      "type": "string",
      "enum": ["rank_full_r2_then_mae_then_candidate_id"]
    },
    "tie_break_rule": {"type": "string", "enum": ["candidate_id_ascending"]},
    "seed": {"type": "string", "enum": ["not_applicable"]},
    "data_cutoff_required": {"type": "boolean"},
    "data_cutoff": {"type": "string", "minLength": 1},
    "origin_dates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "dwt": {
      "type": "object",
      "required": ["wavelet", "levels", "boundary_mode", "signal_scale"],
      "properties": {
        "wavelet": {"type": "string", "enum": ["db4"]},
        "levels": {"type": "integer", "minimum": 1},
        "boundary_mode": {"type": "string", "enum": ["symmetric"]},
        "signal_scale": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "benchmark": {
      "type": "object",
      "required": ["id", "return_prediction", "same_observations"],
      "properties": {
        "id": {"type": "string", "enum": ["random_walk"]},
        "return_prediction": {"type": "number"},
        "same_observations": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "label_maturity": {
      "type": "object",
      "required": ["rule", "minimum_mature_training", "observable_by_cutoff"],
      "properties": {
        "rule": {"type": "string", "enum": ["i_plus_h_strictly_before_origin"]},
        "minimum_mature_training": {"type": "integer", "minimum": 1},
        "observable_by_cutoff": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "promotion_gate": {
      "type": "object",
      "required": [
        "full_r2_positive",
        "full_mae_below_benchmark",
        "full_rmse_below_benchmark",
        "dm_p_value_max",
        "minimum_positive_splits",
        "split_min_observations",
        "minimum_r2",
        "require_causal_reconstruction",
        "require_label_maturity",
        "require_complete_pit_coverage",
        "require_complete_provenance"
      ],
      "properties": {
        "full_r2_positive": {"type": "boolean"},
        "full_mae_below_benchmark": {"type": "boolean"},
        "full_rmse_below_benchmark": {"type": "boolean"},
        "dm_p_value_max": {"type": "number", "minimum": 0},
        "minimum_positive_splits": {"type": "integer", "minimum": 1},
        "split_min_observations": {"type": "integer", "minimum": 1},
        "minimum_r2": {"type": "number"},
        "require_causal_reconstruction": {"type": "boolean"},
        "require_label_maturity": {"type": "boolean"},
        "require_complete_pit_coverage": {"type": "boolean"},
        "require_complete_provenance": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": {"type": "string", "enum": ["H1", "H2"]},
          "statement": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "wavelet_family",
          "levels",
          "boundary_mode",
          "components",
          "signal_scale",
          "estimator",
          "estimation_window"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^db4_l5_sym_(D[1-5]|A5|D3_D4|D3_D4_D5)$"
          },
          "wavelet_family": {"type": "string", "enum": ["db4"]},
          "levels": {"type": "integer", "minimum": 1},
          "boundary_mode": {"type": "string", "enum": ["symmetric"]},
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "enum": ["D1", "D2", "D3", "D4", "D5", "A5"]}
          },
          "signal_scale": {"type": "number", "minimum": 0},
          "estimator": {"type": "string", "enum": ["ols_intercept_signal"]},
          "estimation_window": {"type": "string", "enum": ["expanding"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
