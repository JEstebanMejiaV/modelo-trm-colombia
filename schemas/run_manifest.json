{
  "title": "TRM run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "product_id",
    "status",
    "started_at_utc",
    "finished_at_utc",
    "git_commit",
    "git_dirty",
    "git_status",
    "config_files",
    "config_records",
    "contract_tree_sha256",
    "source_tree_sha256",
    "input_files",
    "output_files",
    "environment"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}$"
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "success",
        "failed"
      ]
    },
    "started_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "finished_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "git_commit": {
      "type": "string",
      "minLength": 1
    },
    "git_dirty": {
      "type": "boolean"
    },
    "git_status": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "config_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "config_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "contract_tree_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_tree_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "output_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "product_id",
          "output_files"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "output_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "platform",
        "packages"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}