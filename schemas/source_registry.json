{
  "title": "TRM source registry",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "provider",
          "raw_path",
          "frequency",
          "unit",
          "transformation",
          "availability_lag_months",
          "status",
          "attribution"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "series_id": {
            "type": "string"
          },
          "raw_path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "frequency": {
            "type": "string",
            "enum": [
              "daily",
              "monthly",
              "quarterly",
              "annual"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "transformation": {
            "type": "string",
            "minLength": 1
          },
          "availability_lag_months": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "candidate",
              "retired"
            ]
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "input_kind": {
            "type": "string",
            "enum": [
              "raw",
              "derived"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}