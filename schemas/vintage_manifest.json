{
  "title": "TRM vintage manifest",
  "type": "object",
  "required": [
    "schema_version",
    "origin_date",
    "mode",
    "immutable",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "origin_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "baseline",
        "snapshot"
      ]
    },
    "immutable": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "raw_path",
          "storage",
          "bytes",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "raw_path": {
            "type": "string",
            "minLength": 1
          },
          "archived_path": {
            "type": "string",
            "minLength": 1
          },
          "storage": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
